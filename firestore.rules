rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인 + 지사 멤버(members/{uid} 문서가 있음)만 사용
    function signedIn() { return request.auth != null; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid)); }
    function access() { return get(/databases/$(database)/documents/settings/access).data; }
    function isAdmin() { return signedIn() && (request.auth.token.email in access().admins); }

    // 입장 코드·관리자 목록: 콘솔에서만 수정, 클라이언트는 읽지 못함(규칙 안에서만 참조)
    match /settings/access { allow read, write: if false; }

    // 멤버 가입: 본인 uid 문서를 만들 때 입장 코드가 맞아야 함
    match /members/{uid} {
      allow read: if isMember();
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.code == access().code
                    && request.resource.data.name is string && request.resource.data.name.size() <= 12;
      allow update: if isMember() && (request.auth.uid == uid || isAdmin());
      allow delete: if isMember() && (request.auth.uid == uid || isAdmin());
    }

    // 상황실 번호 등 지사 공통 설정
    match /settings/main { allow read: if isMember(); allow write: if isMember(); }

    // 공지·일정·현장목소리·댓글·위험현장·알림·맛집·사진 등: 멤버는 읽고 쓰기, 삭제는 작성자나 관리자
    match /{col}/{doc} {
      allow read: if isMember() && col in ['notices','noticeReads','events','voices','comments','reacts','hazards','alerts','foods','foodLikes','photos'];
      allow create: if isMember() && col in ['notices','noticeReads','events','voices','comments','reacts','hazards','alerts','foods','foodLikes','photos']
                    && request.resource.data.by == request.auth.uid;
      allow update: if isMember() && col in ['notices','noticeReads','events','voices','comments','reacts','hazards','alerts','foods','foodLikes','photos']
                    && (resource.data.by == request.auth.uid || isAdmin() || col in ['voices','hazards','notices','events']);
      allow delete: if isMember() && (resource.data.by == request.auth.uid || isAdmin());
    }
  }
}
